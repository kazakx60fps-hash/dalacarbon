# DalaCarbon AI — баптаулар үлгісі.
# Көшірме жасаңыз:  copy .env.example .env   — сосын мәндерді толтырыңыз.

# Сессия кілті: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# db/setup.sql-да қойған құпиясөзді жазыңыз
DATABASE_URL=postgresql://dalacarbon_app:ӨЗ_ПАРОЛІҢІЗ@localhost:5432/dalacarbon
TEST_DATABASE_URL=postgresql://dalacarbon_app:ӨЗ_ПАРОЛІҢІЗ@localhost:5432/dalacarbon_test

# Google арқылы кіру (README → «Google арқылы кіруді баптау»). Бос болса — батырма өшірулі.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Қажет болса ғана: Google Console-дағы redirect URI-ді дәл көрсету
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback

# NDVI картасы (README → «NDVI картасы»). Бос болса — NASA MODIS NDVI (250 м, кілтсіз).
# Copernicus Data Space → Sentinel Hub → Configuration Utility → «Instance ID» (Sentinel-2, 10 м)
SENTINEL_HUB_INSTANCE_ID=
SENTINEL_HUB_LAYER=NDVI

# Құпиясөзді қалпына келтіру хаттары (SMTP). Бос болса — сілтеме сервер терминалына шығады.
# Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_PASSWORD = Google «App password» (16 таңба)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=DalaCarbon AI <noreply@example.kz>
# Хаттағы сілтеме адресі (нақты серверде міндетті): https://dalacarbon.kz
APP_BASE_URL=

# Windows: psycopg libpq.dll-ды осы папкадан табады
PG_BIN=C:/Program Files/PostgreSQL/18/bin
