# DalaCarbon AI — баптаулар үлгісі.
# Көшірме жасаңыз:  copy .env.example .env   — сосын мәндерді толтырыңыз.

# Сессия кілті: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# db/setup.sql-да қойған құпиясөзді жазыңыз
DATABASE_URL=postgresql://dalacarbon_app:ӨЗ_ПАРОЛІҢІЗ@localhost:5432/dalacarbon
TEST_DATABASE_URL=postgresql://dalacarbon_app:ӨЗ_ПАРОЛІҢІЗ@localhost:5432/dalacarbon_test

# Windows: psycopg libpq.dll-ды осы папкадан табады
PG_BIN=C:/Program Files/PostgreSQL/18/bin
